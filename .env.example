TELEGRAM_BOT_ENABLED=false
# Set to false to disable Telegram alerting and bot commands
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Target Telegram User ID for direct private messages (or Chat ID for groups/channels)
TELEGRAM_USER_ID=YOUR_NUMERIC_USER_ID
TELEGRAM_CHAT_ID=YOUR_NUMERIC_CHAT_ID

NVD_API_KEY=
POLL_SECONDS=1800
BOOTSTRAP_HOURS=24
OVERLAP_MINUTES=10
MIN_CVSS=0
ONLY_HIGH_OR_KEV=false
LOG_LEVEL=INFO

# Filter controls: only latest / future vulnerabilities
ONLY_NEWLY_PUBLISHED=true
START_FROM_NOW=true
MAX_CVE_AGE_DAYS=7

# Technology Watchlist: comma-separated list of software/frameworks (e.g. php,laravel,wordpress). Leave empty to monitor all.
WATCHLIST=

# Initial severity rating filter: all, medium, high, critical
RATING_FILTER=

# MCP Server for AI Agents
MCP_ENABLED=true
MCP_URL=http://localhost:8080
MCP_AUTH_TOKEN="your_secure_mcp_auth_token_here"

# Alter chanel this well send aller via http post requst that will be sent to the MCP server for processing. This is useful for integrating with other systems or services.
ALTER_CHANNEL_ENABLED=false
ALTER_CHANNEL_URL=http://localhost:8080/alter-channel-endpoint
ALTER_CHANNEL_AUTH_TOKEN="your_secure_alter_channel_auth_token_here"
